# LLM (chat/answer-generation) - Groq's OpenAI-compatible API.
# Get a free key at https://console.groq.com/keys
# Embeddings do NOT need a key - they run locally (see app/services/embeddings.py).
GROQ_API_KEY=gsk-your-groq-api-key-here
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_CHAT_MODEL=llama-3.3-70b-versatile

# Postgres (matches docker-compose.yml defaults)
DATABASE_URL=postgresql+psycopg2://coverage:coverage@localhost:5433/coverage_qa

# Storage
UPLOAD_DIR=data/uploads
CHROMA_PERSIST_DIR=data/chroma

# Caps / timeouts
MAX_UPLOAD_MB=25
MAX_PDF_PAGES=300
MAX_EXTRACTED_CHARS=2000000
PDF_EXTRACTION_TIMEOUT_SECONDS=60
LLM_REQUEST_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2

# Retrieval
RETRIEVAL_TOP_K=5
RETRIEVAL_SIMILARITY_THRESHOLD=0.3
